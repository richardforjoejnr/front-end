{
  "name": "feathers-chat",
  "description": "dummy app",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {},
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 22.14.0"
  },
  "feathers": {
    "language": "ts",
    "packager": "npm",
    "database": "mongodb",
    "framework": "express",
    "transports": [
      "rest",
      "websockets"
    ],
    "schema": "json"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "files": [
    "lib/client.js",
    "lib/**/*.d.ts",
    "lib/**/*.shared.js"
  ],
  "main": "lib/client",
  "scripts": {
    "dev": "nodemon -x ts-node src/index.ts",
    "compile": "shx rm -rf lib/ && tsc",
    "start": "node lib/",
    "prettier": "npx prettier \"**/*.ts\" --write",
    "test": "vitest run",
    "bundle:client": "npm run compile && npm pack --pack-destination ./public",
    "docker:up": "docker compose up -d --build --wait && npm run --silent docker:url",
    "docker:url": "printf '\\n  Feathers chat is running at http://localhost:%s\\n\\n' \"$(docker compose port app 3030 | sed 's/.*://')\"",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@feathersjs/adapter-commons": "^5.0.50",
    "@feathersjs/authentication": "^5.0.50",
    "@feathersjs/authentication-client": "^5.0.50",
    "@feathersjs/authentication-local": "^5.0.50",
    "@feathersjs/authentication-oauth": "^5.0.50",
    "@feathersjs/configuration": "^5.0.50",
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/express": "^5.0.50",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/mongodb": "^5.0.50",
    "@feathersjs/schema": "^5.0.50",
    "@feathersjs/socketio": "^5.0.50",
    "@feathersjs/transport-commons": "^5.0.50",
    "compression": "^1.8.2",
    "mongodb": "^6.21.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@feathersjs/cli": "^5.0.50",
    "@feathersjs/rest-client": "^5.0.50",
    "@types/node": "^26.6.1",
    "axios": "^1.20.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
